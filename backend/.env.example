# Zoro 2.0 — copy to .env next to app.py. Never commit .env.
OPENAI_API_KEY=
# Model used before (v1 hard-coded value). Change here, not in code.
ZORO_MODEL=gpt-6-luna
# Optional: low | medium | high — only for reasoning models; leave empty otherwise.
ZORO_REASONING_EFFORT=
# App-level key, sent by the v2 Android app in the X-Zoro-Key header.
# Leave EMPTY until the v2 app is installed (the v1 app does not send it).
# Caddy basic auth in front of the app stays on either way.
ZORO_API_KEY=
# Where zoro.db and the v1 JSON files live (default: this folder).
ZORO_DATA_DIR=
ZORO_TZ=Europe/Istanbul
ZORO_USER_TITLE=Zafer Bey
ZORO_USER_FULL_NAME=Zafer Yılmaz
ZORO_HOME_CITY=İstanbul
# Initial value of the "Güncel bilgi" switch; afterwards the phone's settings
# screen decides (stored in zoro.db). Web search is billed per search.
ZORO_WEB_SEARCH=0
# Natural voice model and default voice (the phone's settings screen can change the voice).
# OpenAI shuts gpt-4o-mini-tts down on 2027-01-06; the phone then uses its own voice.
ZORO_TTS_MODEL=gpt-4o-mini-tts
ZORO_TTS_VOICE=marin
# Initial monthly budget in USD; paid extras (web search, natural voice) stop when it is reached. 0 = no limit.
ZORO_MONTHLY_BUDGET_USD=10
# Optional price corrections, USD per 1M tokens [input, cached input, output]:
# ZORO_PRICE_OVERRIDES={"gpt-6-luna": [0.10, 0.01, 0.50]}
ZORO_HOST=127.0.0.1
ZORO_PORT=5050
