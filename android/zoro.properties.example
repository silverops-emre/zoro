# Copy to zoro.properties (git-ignored) before building.
# Zoro sunucusu (Caddy HTTPS). Emulatorde yerel test: http://10.0.2.2:5050
zoro.serverUrl=https://37-27-156-54.sslip.io
# Caddy basic auth kullanici adi / sifresi (sunucudaki Caddyfile ile ayni)
zoro.basicUser=
zoro.basicPassword=
# Sunucudaki ZORO_API_KEY ile ayni (bos birakilabilir)
zoro.apiKey=

# Optional: sign with the keystore that signed the APK already on Zafer Bey's
# phone, so v2 installs as an UPDATE and keeps local calendar/reminders/memory.
# Android Studio "Run" uses %USERPROFILE%\.android\debug.keystore on Windows
# (password android, alias androiddebugkey).
zoro.keystore.path=
zoro.keystore.password=android
zoro.keystore.alias=androiddebugkey
zoro.keystore.keyPassword=android
